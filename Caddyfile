# Set CINEZA_DOMAIN in your environment before starting Caddy
{$CINEZA_DOMAIN:cineza.example.com} {
    # Reverse proxy incoming HTTPS traffic to the frontend upstream
    reverse_proxy {$CINEZA_FRONTEND_UPSTREAM:localhost:3000} {
        header_up Host {http.reverse_proxy.header.host}
        header_up X-Real-IP {http.reverse_proxy.header.x_real_ip}
        header_up X-Forwarded-For {http.reverse_proxy.header.x_forwarded_for}
        header_up X-Forwarded-Proto {scheme}
    }

    # Enable gzip (and zstd) compression
    encode gzip zstd

    # Security Headers (Zero Vulnerabilities Hardening)
    header {
        # Enforce HTTPS strictly (1 year + subdomains)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent MIME-type sniffing
        X-Content-Type-Options "nosniff"

        # Prevent Clickjacking
        X-Frame-Options "SAMEORIGIN"

        # XSS Protection
        X-XSS-Protection "1; mode=block"

        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Content Security Policy (CSP) - Service origins injected via environment variables
        Content-Security-Policy "default-src 'self' {$CINEZA_API_ORIGIN:http://localhost:8080} {$CINEZA_AUTH_OTP_ORIGIN:https://cineza-auth-api.gokulakannansj.workers.dev}; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:;"

        # Permissions Policy
        Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    }

    # Log access and errors
    log {
        output file /var/log/caddy/cineza.access.log
        format json
    }
}
