# Copy this file to .env before deploying (.env is gitignored).
# Safe defaults work out of the box for local development.

# ---- Docker Compose & Networking ----
BIND_HOST=127.0.0.1
NGINX_PORT=8080
NGINX_DNS_RESOLVER=127.0.0.11
BACKEND_SERVICE_URL=http://backend:8080

# ---- Backend Server & CORS ----
SERVER_PORT=8080
CINEZA_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://localhost:*,https://127.0.0.1:*

# ---- Database (MySQL) ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_LOCAL_PORT=3307
MYSQL_DATABASE=cineza_db
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-password
# Optional full JDBC override for external/managed MySQL (e.g., RDS / PlanetScale):
# SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/cineza_db?useSSL=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=replace-with-strong-mysql-password

# ---- Cache & Distributed Seat Locking (Redis) ----
SPRING_DATA_REDIS_HOST=redis
REDIS_PORT=6379
SPRING_DATA_REDIS_PORT=6379

# ---- Authentication (JWT) ----
# Shared HS512 signing secret across all backend replicas (min 64 chars / 512 bits recommended)
CINEZA_JWT_SECRET=replace-with-random-64-plus-character-hex-string-from-openssl-rand-hex-64
CINEZA_JWT_EXPIRATION_MS=86400000

# ---- Caddy Reverse Proxy ----
CINEZA_DOMAIN=cineza.example.com
CINEZA_FRONTEND_UPSTREAM=localhost:3000
CINEZA_API_ORIGIN=http://localhost:8080
CINEZA_AUTH_OTP_ORIGIN=https://cineza-auth-api.gokulakannansj.workers.dev

# ---- Frontend Service Discovery (--dart-define / --dart-define-from-file=.env) ----
CINEZA_API_BASE_URL=http://localhost:8080/api/v1
CINEZA_AUTH_OTP_URL=https://cineza-auth-api.gokulakannansj.workers.dev/auth/otp
CINEZA_PUBLIC_WEB_URL=https://cineza.com
CINEZA_TRAILER_EMBED_BASE_URL=https://www.youtube.com/embed
CINEZA_PLACEHOLDER_IMAGE_BASE_URL=https://via.placeholder.com
CINEZA_DEFAULT_POSTER_URL=https://image.tmdb.org/t/p/w500/1pdfLvkbY9ohJlCjQH2CZjjYVvJ.jpg
